{
  "info": {
    "name": "Banking API",
    "description": "Requests for the Spring Boot banking API. Run the folders top to bottom (or use the Collection Runner): 'Create Amy' and 'Create Bob' store their IDs in collection variables used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "amyId", "value": "" },
    { "key": "bobId", "value": "" }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Amy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('holder is Amy', () => pm.expect(body.accountHolder).to.eql('Amy'));",
                  "pm.collectionVariables.set('amyId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountHolder\": \"Amy\",\n  \"initialBalance\": 100\n}" },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Create Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bobId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountHolder\": \"Bob\",\n  \"initialBalance\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Get Amy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns Amy', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('amyId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/accounts/{{amyId}}", "host": ["{{baseUrl}}"], "path": ["accounts", "{{amyId}}"] }
          }
        },
        {
          "name": "Get unknown account (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/accounts/does-not-exist", "host": ["{{baseUrl}}"], "path": ["accounts", "does-not-exist"] }
          }
        },
        {
          "name": "Create with blank name (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('validation message', () => pm.expect(pm.response.json().message).to.eql('Validation failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountHolder\": \"\",\n  \"initialBalance\": 100\n}" },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Create with negative balance (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountHolder\": \"Eve\",\n  \"initialBalance\": -5\n}" },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer Amy -> Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const tx = pm.response.json();",
                  "pm.test('amount is 30', () => pm.expect(Number(tx.amount)).to.eql(30));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountID\": \"{{amyId}}\",\n  \"toAccountID\": \"{{bobId}}\",\n  \"amount\": 30\n}" },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          }
        },
        {
          "name": "Transfer insufficient funds (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountID\": \"{{amyId}}\",\n  \"toAccountID\": \"{{bobId}}\",\n  \"amount\": 100000\n}" },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          }
        },
        {
          "name": "Transfer to same account (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountID\": \"{{amyId}}\",\n  \"toAccountID\": \"{{amyId}}\",\n  \"amount\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          }
        },
        {
          "name": "Transfer to unknown account (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountID\": \"{{amyId}}\",\n  \"toAccountID\": \"does-not-exist\",\n  \"amount\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          }
        },
        {
          "name": "Transfer zero amount (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountID\": \"{{amyId}}\",\n  \"toAccountID\": \"{{bobId}}\",\n  \"amount\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Amy's transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/accounts/{{amyId}}/transactions", "host": ["{{baseUrl}}"], "path": ["accounts", "{{amyId}}", "transactions"] }
          }
        },
        {
          "name": "Transactions for unknown account (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/accounts/does-not-exist/transactions", "host": ["{{baseUrl}}"], "path": ["accounts", "does-not-exist", "transactions"] }
          }
        }
      ]
    }
  ]
}
